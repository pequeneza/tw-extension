{
  "manifest_version": 3,
  "name": "xBot",
  "version": "1.0.0",
  "description": "TribalWars PT automation suite — 10 modules, in-game overlay. Opt-in per module.",
  "permissions": ["storage", "scripting", "activeTab", "tabs", "notifications", "declarativeNetRequest", "privacy"],
  "host_permissions": [
    "https://*.tribalwars.com.pt/*",
    "https://license.vivaomadeira.com/*"
  ],

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "xBot",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": ["https://*.tribalwars.com.pt/game.php*"],
      "js": [
        "content/overlay.js",
        "content/router.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ],

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "tracking_block",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },

  "web_accessible_resources": [
    {
      "resources": [
        "modules/*.js",
        "assets/*",
        "icons/*"
      ],
      "matches": ["https://*.tribalwars.com.pt/*"]
    }
  ]
}
